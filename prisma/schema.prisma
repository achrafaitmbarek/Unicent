datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  bankConnections BankConnection[]
  financialGoals FinancialGoal[]
  financialTips FinancialTip[]
  isPremium     Boolean         @default(false)
  
  financialReports FinancialReport[] 
  spendingReports SpendingOptimizationReport[]
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BankConnection {
  id            String   @id @default(cuid())
  userId        String
  providerId    String  
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  lastRefresh   DateTime?

  accounts      BankAccount[]

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
}
model BankAccount {
  pk             String   @id @default(cuid())    
  id             Int                                     
  number         String
  balance        Float
  name           String
  iban           String
  currencyId     String
  currencySymbol String
  lastSyncedTransactionDate DateTime?

  connectionId   String
  connection     BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  transactions   Transaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([connectionId, id])
  @@index([connectionId])
}
enum TransactionFlow {
  INCOME
  EXPENSE
}

model Transaction {
  pk        String   @id @default(cuid())  
  id        Int                              
  wording   String
  date      DateTime
  rdate     DateTime
  value     Float
  type      String
  flow      TransactionFlow @default(EXPENSE)
  category  TransactionCategory @default(OTHER) 

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [pk], onDelete: Cascade)

  isUnusual      Boolean @default(false)
  riskLevel      String? 
  anomalyReason  String?
  recommendedAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, id])
  @@index([accountId])
  @@index([date])
}
enum TransactionCategory {

  SALARY
  INVESTING
  BUSINESS_INCOME
  RENTAL_INCOME
  FREELANCE
  REFUND
  PENSION
  DIVIDEND
  GIFT_RECEIVED
  INTEREST

  SUBSCRIPTION
  GROCERIES
  SHOPPING
  DINING
  TRANSPORTATION
  UTILITIES
  ENTERTAINMENT
  HOUSING
  HEALTHCARE  
  EDUCATION
  

  TRAVEL
  TRANSFER
  OTHER
}

model FinancialGoal {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  targetDate  DateTime
  category    Category
  monthlyAllocationPct Float 
  
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum TipType {
  GOAL_BASED
  DAILY_INSIGHT
  SPIKE
}
model FinancialTip {
  id          String   @id @default(cuid())
  title       String
  description String
  isLiked     Boolean?
  type        TipType  @default(DAILY_INSIGHT)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
}

enum Category {
  TRAVEL
  EMERGENCY
  RETIREMENT
  EDUCATION
  OTHER
  HOME_PURCHASE
  VEHICLE
  WEDDING
  DEBT_PAYOFF
  VACATION
  HEALTHCARE
  BUSINESS
  TECHNOLOGY
  HOLIDAY
  CHILDREN
  HOME_IMPROVEMENT
  INVESTMENT
  CHARITY
  PET
  FITNESS
  ENTERTAINMENT
  ANNIVERSARY
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
 model FinancialReport {
  id          String   @id @default(cuid())
  title       String   
  month       Int      
  year        Int      
  

  totalIncome     Float
  totalExpenses   Float
  savingsRate     Float   
  
  spendingBreakdown Json  
  

  predictedIncome    Float
  predictedExpenses  Float
  
  savingsTips        FinancialReportTip[]
  

  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year]) 
  @@index([userId])
  @@index([month, year])
}

model FinancialReportTip {
  id          String   @id @default(cuid())
  title       String
  description String
  context     String? 

  reportId    String
  report      FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportId])
}


enum OptimizationPriority {
  LOW
  MEDIUM
  HIGH
}

model SpendingOptimizationReport {
  id              String   @id @default(cuid())
  month           Int
  year            Int
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  totalCurrentSpending Float
  totalRecommendedSpending Float
  totalPotentialSavings Float
  
  recommendations CategoryRecommendation[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId, month, year]) 
  @@index([userId])
}

model CategoryRecommendation {
  id               String   @id @default(cuid())
  category         TransactionCategory
  currentSpending  Float
  recommendedSpending Float
  potentialSavings Float
  spendingPercentage Float  
  
  title            String
  description      String
  subdescription   String?
  priority         OptimizationPriority
  
  reportId         String
  report           SpendingOptimizationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([reportId])
  @@index([category])
}
