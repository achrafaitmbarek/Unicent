// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// Define your models here

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String?
  name                 String?
  profilePicture       String?
  googleId             String?   @unique
  isPremium            Boolean   @default(false)
  aiNotificationFrequency AINotificationFrequency?
  preferredInsightTypes InsightType[]
  reportType           ReportType?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  bankAccounts         BankAccount[]
  transactions         Transaction[]
  categories           Category[]
  goals                Goal[]
}

model BankAccount {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  accountNumber String
  bankName      String
  balance       Float
  lastUpdated   DateTime
  transactions  Transaction[]
}

model Transaction {
  id            String    @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  amount        Float
  description   String
  date          DateTime
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  type          TransactionType
}

model Category {
  id           String    @id @default(cuid())
  name         String
  type         CategoryType
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Float
  currentAmount Float    @default(0)
  startDate    DateTime
  targetDate   DateTime
  category     GoalCategory
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  description  String?
}

enum AINotificationFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum InsightType {
  SAVINGS
  SPENDING
  INVESTMENT
  CASH_FLOW
}

enum ReportType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum GoalCategory {
  SAVINGS
  DEBT_REPAYMENT
  INVESTMENT
}