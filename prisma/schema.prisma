datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  bankConnections BankConnection[]
  financialGoals FinancialGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BankConnection {
  id            String   @id @default(cuid())
  userId        String
  providerId    String  
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  lastRefresh   DateTime?

  accounts      BankAccount[]

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
}
model BankAccount {
  pk             String   @id @default(cuid())    
  id             Int                                     
  number         String
  balance        Float
  name           String
  iban           String
  currencyId     String
  currencySymbol String

  connectionId   String
  connection     BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  transactions   Transaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([connectionId, id])
  @@index([connectionId])
}
enum TransactionFlow {
  INCOME
  EXPENSE
}

model Transaction {
  pk        String   @id @default(cuid())  
  id        Int                              
  wording   String
  date      DateTime
  rdate     DateTime
  value     Float
  type      String
  flow      TransactionFlow @default(EXPENSE)
  category  TransactionCategory @default(OTHER) 

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [pk], onDelete: Cascade)

  isUnusual      Boolean @default(false)
  riskLevel      String? 
  anomalyReason  String?
  recommendedAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, id])
  @@index([accountId])
  @@index([date])
}
enum TransactionCategory {
  SUBSCRIPTION
  INVESTING
  GROCERIES
  SHOPPING
  DINING
  TRANSPORTATION
  UTILITIES
  ENTERTAINMENT
  HOUSING
  HEALTHCARE  
  EDUCATION
  TRAVEL
  OTHER
}

model FinancialGoal {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  targetDate  DateTime
  category    Category
  monthlyAllocationPct Float 
  
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum Category {
  TRAVEL
  EMERGENCY
  RETIREMENT
  EDUCATION
  OTHER
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}

 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 